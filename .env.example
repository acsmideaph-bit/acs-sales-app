# Copy to .env.local for local development. Both values are public by design
# (RLS protects the data). Find them in Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://<ACS_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Optional: path the app is served under (GitHub Pages repo name)
# VITE_BASE=/acs-sales-app/
